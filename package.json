    "@sanity/client": "^6.22.4",
    "@tanstack/react-query": "^5.59.13",
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "firebase": "^10.14.1",
    "js-cookie": "^3.0.5",
    "react": "^18.3.1",
    "react-detect-click-outside": "^1.1.7",
    "react-dom": "^18.3.1",
    "react-router": "^6.27.0",
    "react-router-dom": "^6.27.0",
    "react-simple-maps": "^3.0.0"
