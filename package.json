{
  "name": "tribe-africa-admin",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "test": "echo \"No tests specified\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky install"
  },
